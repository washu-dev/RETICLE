                <mxCell id="s5" value="STAGE 5 — Roll-up &amp; FDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e6f1;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1140" width="800" height="180" as="geometry"/>
