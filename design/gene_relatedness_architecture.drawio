                <mxCell id="s4b-store" value="dim_gene_expectation_model&#xa;(fitted params per version×config)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;fillColor=#e1d5ff;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="740" width="240" height="70" as="geometry"/>
