                    <mxGeometry x="1080" y="900" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s4-dims" value="Evidence rows → dim_gene_pair_screen · dim_gene_pair_context · dim_gene_pair_publication&#xa;(each channel: effect · support · significance p)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5ff;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="1005" width="760" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s4b" value="STAGE 4b (D5b) — Residual / mechanistic-divergence&#xa;&quot;find genes that break the same rule&quot; (ADDITIVE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#82b366;verticalAlign=top;fontStyle=1;dashed=1;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="860" width="330" height="315" as="geometry"/>
                </mxCell>
                <mxCell id="s4b-exp" value="Fit LIGHT additive / median-polish / mixed-effects&#xa;E[g,i] = gene baseline + screen baseline + context-group means&#xa;(modality · library · cell_line · assay_domain)&#xa;NOT a Gaussian process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1305" y="895" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s4b-resid" value="⑤ Residual co-essentiality&#xa;R = observed − E · tail-restricted |ρ| of residual profiles&#xa;novelty_score = contrast(resid_rho vs raw_rho)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1305" y="985" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s4b-flags" value="Flags: is_antagonistic (strong −ρ)&#xa;is_buffering_candidate + buffering_basis&#xa;HYPOTHESIS only — testable by combinatorial KO&#xa;(single-gene ORCS cannot measure true buffering)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1305" y="1065" width="300" height="95" as="geometry"/>
