                <mxCell id="s1" value="STAGE 1 — Profiler (cheap, NO n×n)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#82b366;verticalAlign=top;fontStyle=1;" parent="1" vertex="1">
