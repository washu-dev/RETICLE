                <mxCell id="s3" value="STAGE 3 — Candidate generation (evidence-generated, NOT cartesian)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#82b366;verticalAlign=top;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="460" y="650" width="800" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3-body" value="• Partition by ORGANISM (never cross)&#xa;• Prefilter to SELECTIVE genes (drop pan-essential &amp; pan-inert → quadratic reduction)&#xa;• Candidate set = ∪ (co-measured FULL screens, co-hit HIT_ONLY, co-cited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="480" y="685" width="470" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="s3-mode" value="Compute mode&#xa;EXACT (default)&#xa;⟶ ANN top-K FALLBACK&#xa;only if profiler flags&#xa;budget overflow" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="680" width="220" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="STAGE 4 — Metric computation (DETERMINISTIC · exact ρ · tiled/thresholded GEMM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#82b366;verticalAlign=top;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="460" y="860" width="800" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="s4-c1" value="① Co-essentiality (PRIMARY)&#xa;tail-restricted |Spearman ρ|&#xa;over shared FULL screens&#xa;GPU/CPU tiled GEMM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="900" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s4-c2" value="② Co-hit enrichment&#xa;Jaccard + PMI + Fisher&#xa;sparse Hᵀ·H (HIT_ONLY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="680" y="900" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s4-c3" value="③ Co-citation&#xa;PMI + Jaccard over&#xa;shared publications&#xa;(cold-start rescue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="880" y="900" width="180" height="90" as="geometry"/>
