# react-native 0.76 declares a peer dependency on @types/react 18.x, but this app is on React 19
# (react ^19.0.0 / @types/react ^19.0.0). That mismatch is upstream — RN 0.76 predates the React 19
# types — and npm's strict peer resolution fails on it as soon as anything forces a full
# re-resolution, which the `overrides` in package.json do. Without this, `npm ci` errors ERESOLVE.
legacy-peer-deps=true
